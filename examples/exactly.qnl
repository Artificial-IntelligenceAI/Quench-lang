# `e` never rounds. That is the whole of it.

START {
    var.immut.e ['third'] = [*1* / *3*];
    var.immut.e ['back']  = ['third' x *3*];
    print.stdout[str:*a third is * 'third' str:*, and times three is * 'back' \n];

    # The one every language is famous for getting wrong.
    var.immut.e    ['sum']   = [e:*0.1* + e:*0.2*];
    var.immut.bool ['right'] = [e:*0.1* + e:*0.2* == e:*0.3*];
    print.stdout[str:*0.1 + 0.2 = * 'sum' str:*, and that is 0.3: * 'right' \n];

    # A decimal point is exact here, so this is one tenth rather than the `b64`
    # nearest to it. That is the reason to write one.
    var.immut.e ['tenth'] = [*0.1*];
    var.immut.e ['ratio'] = [*1* / *10*];
    print.stdout[str:*written two ways, same number: * 'tenth' str:* * 'ratio' \n];

    # Absurdly big, which is the other half of what it is for.
    var.immut.e ['huge']    = [*99999999999999999999999999999999*];
    var.immut.e ['squared'] = ['huge' x 'huge'];
    print.stdout[str:*squared = * 'squared' \n];
}
