# A constant array lives in the module, beside the text -- so its handle is
# known before anything runs, and naming it costs nothing at all.
const.file.arr.i64 (3) ['PRIMES'] = [[*2* *3* *5*]];

START {
    var.immut.arr.i64 (5) ['xs'] = [[*10* *20* *30* *40* *50*]];
    print.stdout[str:*xs[1] = * 'xs'[*1*] str:*, xs[5] = * 'xs'[*5*] \n];

    # (2 3) is one allocation, two rows of three, written flat -- the type
    # already gave the shape, and writing it twice is a chance to disagree.
    var.immut.arr.i64 (2 3) ['m'] = [[
        *1* *2* *3*
        *4* *5* *6*
    ]];
    print.stdout[str:*m[2 3] = * 'm'[*2* *3*] \n];

    # A whole array prints everything it holds, flat however many dimensions it
    # has -- because flat is how the elements were written.
    print.stdout[str:*xs = * 'xs' str:*, m = * 'm' \n];

    # An array is the only thing two names can reach, so binding one says which of
    # the two it meant. `share` costs nothing and lets a change here be seen there;
    # `copy` makes a second array and pays for it.
    var.mut.arr.i64 (3) ['counts'] = [[*1* *2* *3*]];
    var.mut.arr.i64 (3) ['same']   = [share 'counts'];
    var.mut.arr.i64 (3) ['mine']   = [copy 'counts'];
    set ['counts'[*1*]] = [*99*];
    print.stdout[str:*counts = * 'counts' str:*, same = * 'same' str:*, mine = * 'mine' \n];

    # And `==` asks about contents, which it could not until `share` existed to ask
    # the other question with.
    var.immut.bool ['alike'] = ['counts' == 'same'];
    print.stdout[str:*counts == same: * 'alike' \n];

    # Two `arr` links are two allocations: two rows of three, and something
    # pointing at both. Written flat like any other, since the type gave the shape.
    var.mut.arr.arr.i64 (2 3) ['rows'] = [[*1* *2* *3* *4* *5* *6*]];
    print.stdout[str:*rows = * 'rows' \n];

    # An index may stop where an allocation ends, and what it hands back is the
    # array that lives there -- which is the whole reason to write two links.
    var.mut.arr.i64 (3) ['second'] = [share 'rows'[*2*]];
    set ['second'[*1*]] = [*99*];
    print.stdout[str:*rows = * 'rows' \n];

    # There is one of a constant array, so `share` names that one and `copy` gives
    # you one you may change. Nothing can change the constant itself.
    var.mut.arr.i64 (3) ['primes_copy'] = [copy 'PRIMES'];
    set ['primes_copy'[*1*]] = [*99*];
    print.stdout[str:*PRIMES = * 'PRIMES' str:*, copy = * 'primes_copy' \n];
}
