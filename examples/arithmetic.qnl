START {
    var.i64 ['a'] = [*7*];
    var.i64 ['b'] = [*3*];

    var.i64 ['sum'] = ['a' + 'b'];
    print[str:*a + b         = * 'sum' \n];
    var.i64 ['product'] = ['a' x 'b'];
    print[str:*a x b         = * 'product' \n];

    var.i64 ['plain']  = [*1* + *2* x *3*];
    var.i64 ['forced'] = [(*1* + *2*) x *3*];
    print[str:*1 + 2 x 3     = * 'plain' \n];
    print[str:*(1 + 2) x 3   = * 'forced' \n];

    var.bool ['bigger'] = ['a' > 'b'];
    print[str:*7 > 3         = * 'bigger' \n];
}
