import [input];
import [text];

# What arrived from outside: the arguments the program was started with, and standard
# input. Four functions behind `input`, bare because they are Quench's.
#
#     printf 'Tankun\n42\nand the rest\n' | quench run examples/reading-input.qnl hello there

START {
    var.immut.arr.str (grow) ['given'] = [call input.arguments[]];
    print.stdout[str:*started with * call count[share 'given'] str:* arguments* \n];

    if call count[share 'given'] > *0* {
        print.stdout[str:*the first is * 'given'[*1*] \n];
    }

    # `more` is the question and `line` is the answer -- the third pair of that shape,
    # after `is`/`as` and `text.has`/`text.find`. Reading past the end stops the program,
    # and asking first is what makes that impossible rather than unlikely. The check is
    # honest because nothing races it: one program reads its own input, in order.
    #
    # `line` hands back the bytes that were *there*, ending included. `text.trim` is what
    # takes the ending off, and it is written here rather than done for you because a
    # line that ends `\r\n` really does hold a carriage return, and removing a character
    # the input held without saying so is not something the language does.
    if call input.more[] {
        var.immut.str ['who'] = [call text.trim[call input.line[]]];
        print.stdout[str:*hello, * 'who' str:*!* \n];
    }

    # A number off the input is both pairs at once: ask whether there is a line, then
    # ask whether the line is a number.
    if call input.more[] {
        var.immut.str ['said'] = [call text.trim[call input.line[]]];
        if call is.i64['said'] {
            var.immut.i64 ['n'] = [call as.i64['said']];
            var.immut.i64 ['twice'] = ['n' + 'n'];
            print.stdout[str:*twice that is * 'twice' \n];
        } else {
            print.stderr[str:*that was not a number: * 'said' \n];
        }
    }

    # The loop the question is for: read until there is nothing left. `more` is asked
    # again before every pass, so nothing here can stop.
    var.mut.i64 ['lines'] = [*0*];
    loop.while call input.more[] {
        var.immut.str ['each'] = [call input.line[]];
        set ['lines'] = ['lines' + *1*];
        print.stdout[str:*  line * 'lines' str:*: [* call text.trim['each'] str:*]* \n];
    }

    # `all` takes everything left in one go instead, for a program that wants the whole
    # of its input before it starts -- and `\n` is an ordinary value, so `text.split`
    # cuts it into lines. Bytes that are not text become the replacement character or
    # stop the program, whichever `[defaults] bad-bytes` says.
    #
    # The loop above has already taken everything, so this is the empty case: splitting
    # text that holds no separator gives one piece, and that piece is the whole text.
    var.immut.arr.str (grow) ['rest'] = [call text.split[call input.all[], \n]];
    print.stdout[str:*nothing left, which splits into * call count[share 'rest'] str:* piece* \n];
}
